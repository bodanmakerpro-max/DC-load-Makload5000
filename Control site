<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>DC Load Controller V6</title>
<style>
:root{
  --bg:#080b0e;--panel:#10161b;--panel2:#0b1014;--panel3:#151d24;
  --line:#2d3942;--line2:#202a31;--text:#e8edf0;--muted:#82909a;
  --green:#31dfa0;--yellow:#f2c454;--red:#ff4057;--blue:#6ba8df;--amber:#d8a94c;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{font-family:"Segoe UI",Arial,sans-serif;background:#070a0d;color:var(--text);overflow:hidden}
body.alarm{animation:alarmFlash .58s infinite}
@keyframes alarmFlash{0%,100%{box-shadow:inset 0 0 0 rgba(255,64,87,0)}50%{box-shadow:inset 0 0 140px 24px rgba(255,64,87,.34)}}
.shell{height:100dvh;display:grid;grid-template-rows:48px minmax(0,1fr) auto;background:linear-gradient(180deg,#0c1115,#080b0e)}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:0 16px;border-bottom:1px solid var(--line);background:linear-gradient(#171d22,#10151a)}
.brand{display:flex;align-items:center;gap:12px}.brandMark{width:28px;height:28px;border:1px solid #45515a;display:grid;place-items:center;font:700 12px Consolas,monospace;color:var(--green);background:#0a0e11}.brandText{font:700 15px Consolas,monospace;letter-spacing:.12em}.brandSub{font-size:10px;color:var(--muted);letter-spacing:.08em;margin-top:2px}
.status{display:flex;align-items:center;gap:8px;font:11px Consolas,monospace;color:var(--muted)}.dot{width:9px;height:9px;border-radius:50%;background:#4d5962}.dot.on{background:var(--green);box-shadow:0 0 10px rgba(49,223,160,.8)}
.main{min-height:0;display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:10px;padding:10px}
.left,.right{min-height:0}.left{display:grid;grid-template-rows:minmax(0,1fr) auto;gap:10px}.right{display:flex;flex-direction:column;gap:8px;overflow:auto;padding-right:2px}
.panel{border:1px solid var(--line);background:linear-gradient(180deg,#11181e,#0c1115);box-shadow:0 6px 18px rgba(0,0,0,.25)}
.panelHead{height:29px;display:flex;align-items:center;justify-content:space-between;padding:0 10px;border-bottom:1px solid var(--line2);background:#12191f;font:700 10px Consolas,monospace;letter-spacing:.13em;color:#9aa7b0}
.panelBody{padding:10px}
.gaugePanel{min-height:0;display:grid;grid-template-rows:29px minmax(0,1fr)}
.gaugeBody{min-height:0;display:grid;grid-template-rows:minmax(250px,1fr) auto;padding:0 10px 8px}
.gaugeWrap{position:relative;min-height:225px;height:100%;display:flex;align-items:center;justify-content:center;overflow:hidden}
.carGauge{position:relative;width:min(625px,88%);aspect-ratio:2/1.08;max-height:338px}
.gaugeArc{position:absolute;left:5%;right:5%;bottom:8%;height:86%;border-radius:500px 500px 0 0;overflow:hidden;background:conic-gradient(from 270deg at 50% 100%,var(--green) 0deg 150deg,var(--yellow) 150deg 171deg,var(--red) 171deg 180deg,transparent 180deg 360deg);filter:drop-shadow(0 0 8px rgba(0,0,0,.35))}
.gaugeArc::after{content:"";position:absolute;left:11%;right:11%;bottom:-2px;height:78%;border-radius:500px 500px 0 0;background:#0d1318;border:1px solid #26313a}
.gaugeNeedle{position:absolute;width:37%;height:4px;left:13%;bottom:18%;transform-origin:100% 50%;transform:rotate(0deg);transition:transform .14s linear;background:linear-gradient(90deg,transparent 0%,#dce3e7 35%,#fff 100%);border-radius:10px;z-index:5;filter:drop-shadow(0 0 4px rgba(255,255,255,.16))}
.gaugeHub{position:absolute;left:50%;bottom:18%;transform:translate(-50%,50%);width:30px;height:30px;border-radius:50%;background:#eef2f4;border:8px solid #33404a;z-index:6}
.readOverlay{
  position:absolute;
  left:50%;
  top:47%;
  transform:translate(-50%,-50%);
  z-index:10;
  text-align:center;
  pointer-events:none;
  min-width:210px;
}
.amps{
  font:700 58px/0.95 Consolas,monospace;
  letter-spacing:-.055em;
  color:#f0f4f6;
  text-shadow:0 2px 8px rgba(0,0,0,.65);
}
.unit{
  margin-top:9px;
  font:10px Consolas,monospace;
  letter-spacing:.22em;
  color:#9ba8b1;
}
.alarmText{
  min-height:16px;
  margin-top:7px;
  font:700 9px Consolas,monospace;
  letter-spacing:.08em;
  color:var(--red);
}

.gaugeTicks{position:absolute;left:4%;right:4%;bottom:1%;display:flex;justify-content:space-between;font:11px Consolas,monospace;color:#87949d;z-index:8}
.controlStrip{border-top:1px solid var(--line2);padding:7px 10px 0}.setRow{display:grid;grid-template-columns:125px minmax(150px,1fr) 104px;gap:10px;align-items:center}.setLabel{font:10px Consolas,monospace;color:var(--muted);letter-spacing:.12em}.setValue{font:700 26px Consolas,monospace;margin-top:2px}.setValue small{font-size:13px;color:#bac3c9}.slider{width:100%;accent-color:var(--green);margin:0}.num{width:100%;height:38px;border:1px solid #3a4650;background:#080d10;color:var(--text);padding:0 9px;font:700 18px Consolas,monospace;outline:none}.actions{display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px;margin-top:8px}
button{height:36px;border:1px solid #40505b;background:linear-gradient(#26313a,#182027);color:var(--text);font:700 11px Consolas,monospace;letter-spacing:.05em;cursor:pointer}button:hover{filter:brightness(1.1)}button:disabled{opacity:.38;cursor:not-allowed}.onbtn{border-color:#327a5c;color:#b8f2d7}.offbtn{border-color:#51616e}.clearbtn{border-color:#82434d;color:#ffbdc5}.connect{width:100%;border-color:#3d7297;color:#c3e1f5}.go{border-color:#766130;color:#ffe4a4}.capture{border-color:#455765}.reset{width:100%;border-color:#7f414a;color:#ffc1c9}
.kpis{display:grid;grid-template-columns:1fr 1fr;gap:6px}.kpi{background:#0a0f13;border:1px solid var(--line2);padding:8px}.kpiName{font:9px Consolas,monospace;color:var(--muted);letter-spacing:.1em}.kpiValue{font:700 16px Consolas,monospace;margin-top:4px}.mode{display:flex;align-items:center;justify-content:space-between;border:1px solid var(--line2);background:#0a0f13;padding:8px;margin-bottom:6px}.modeLabel{font:700 12px Consolas,monospace}.badge{border:1px solid #52606a;padding:3px 7px;font:700 10px Consolas,monospace;color:#9ea9b1}.badge.run{color:#b9f1d3;border-color:#34785b}.badge.trip{color:#ffc0c7;border-color:#96464f}
.presets{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.preset{height:30px;font-size:10px}
.calHelp{font:10px/1.35 Consolas,monospace;color:var(--muted);margin-bottom:6px}.calPoint{border:1px solid var(--line2);background:#0b1014;padding:7px;margin-top:5px}.calHead{display:flex;align-items:center;justify-content:space-between;margin-bottom:5px}.calTitle{font:700 11px Consolas,monospace}.calState{font:9px Consolas,monospace;color:var(--muted)}.calState.good{color:var(--green)}.calRow{display:grid;grid-template-columns:62px minmax(0,1fr) 76px;gap:5px}.calRow button{height:30px;font-size:9px}.calInput{min-width:0;height:30px;border:1px solid #36424a;background:#080d10;color:var(--text);padding:0 7px;font:13px Consolas,monospace}.calInfo{font:9px Consolas,monospace;color:var(--muted);margin-top:5px;min-height:11px}.calInfo.good{color:var(--green)}.calInfo.bad{color:var(--red)}
.message{font:9px/1.35 Consolas,monospace;color:var(--muted);margin-top:6px;min-height:12px}
.debug{border-top:1px solid var(--line);background:#0a0e11}.debugBar{list-style:none;height:34px;display:flex;align-items:center;justify-content:space-between;padding:0 10px;cursor:pointer;user-select:none;background:linear-gradient(#131a20,#0d1216)}.debugBar::-webkit-details-marker{display:none}.debugBar::marker{display:none}.debugTitle{font:700 10px Consolas,monospace;letter-spacing:.12em;color:#9ba8b0}.debugHint{font:9px Consolas,monospace;color:#63717a}.debugBody{height:clamp(390px,56vh,680px);border-top:1px solid var(--line2);padding:8px 10px;display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,.8fr);gap:8px}.logBox{min-width:0;background:#05080a;border:1px solid #29333a;padding:7px;overflow:auto;font:10px/1.35 Consolas,monospace;color:#93c6a9;white-space:pre-wrap}.debugSide{display:grid;grid-template-rows:auto auto 1fr;gap:6px}.cmdRow{display:grid;grid-template-columns:minmax(0,1fr) 70px;gap:5px}.cmdInput{height:31px;background:#060a0d;border:1px solid #37434b;color:#dfe7eb;padding:0 7px;font:11px Consolas,monospace}.miniBtns{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.miniBtns button{height:29px;font-size:9px}.debugStats{display:grid;grid-template-columns:1fr 1fr;gap:4px}.debugStat{border:1px solid #263038;background:#080c0f;padding:5px;font:9px Consolas,monospace;color:#7f8c95}.debugStat b{display:block;color:#c8d0d5;font-size:10px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media(max-width:1100px){.main{grid-template-columns:minmax(0,1fr) 340px}.setRow{grid-template-columns:112px 1fr 92px}.panelBody{padding:8px}.right{gap:6px}.calPoint{padding:6px}}
@media(max-height:760px){.debugBody{height:clamp(320px,50vh,480px)}.main{padding:7px;gap:7px}.gaugeWrap{min-height:195px}.carGauge{width:min(560px,86%);max-height:305px}.amps{font-size:50px}.panelHead{height:26px}.gaugePanel{grid-template-rows:26px minmax(0,1fr)}.setRow{grid-template-columns:112px 1fr 95px}.actions button{height:32px}.panelBody{padding:7px}.kpi{padding:6px}.calPoint{padding:5px;margin-top:4px}.calRow button,.calInput{height:28px}.presets button{height:28px}.right{gap:5px}.debugBar{height:30px}}
@media(max-width:820px){body{overflow:auto}.shell{height:auto;min-height:100vh}.main{grid-template-columns:1fr}.right{overflow:visible}.debugBody{grid-template-columns:1fr;height:auto;max-height:72vh;min-height:380px}.logBox{height:280px}.setRow{grid-template-columns:110px 1fr 90px}}
</style>
</head>
<body>
<div class="shell">
  <header class="topbar">
    <div class="brand">
      <div class="brandMark">DL</div>
      <div><div class="brandText">DC LOAD CONTROL</div><div class="brandSub">CLOSED LOOP ELECTRONIC LOAD</div></div>
    </div>
    <div class="status"><span id="dot" class="dot"></span><span id="connText">SERIAL OFFLINE</span></div>
  </header>

  <main class="main">
    <section class="left">
      <div class="panel gaugePanel">
        <div class="panelHead"><span>CURRENT MONITOR</span><span>0.00 - 3.00 A</span></div>
        <div class="gaugeBody">
          <div class="gaugeWrap">
            <div class="carGauge">
              <div class="gaugeArc"></div>
              <div id="gaugeNeedle" class="gaugeNeedle"></div>
              <div class="gaugeHub"></div>
              <div class="readOverlay"><div id="amps" class="amps">0.00</div><div class="unit">AMPERES</div><div id="alarmText" class="alarmText"></div></div>
              <div class="gaugeTicks"><span>0 A</span><span>0.75</span><span>1.50</span><span>2.25</span><span>3.00 A</span></div>
            </div>
          </div>
          <div class="controlStrip">
            <div class="setRow">
              <div><div class="setLabel">SET CURRENT</div><div class="setValue"><span id="setBig">1.00</span> <small>A</small></div></div>
              <input id="slider" class="slider" type="range" min="0" max="3" step="0.01" value="1.00">
              <input id="number" class="num" type="number" min="0" max="3" step="0.01" value="1.00">
            </div>
            <div class="actions">
              <button id="onBtn" class="onbtn" disabled>LOAD ON</button>
              <button id="offBtn" class="offbtn" disabled>LOAD OFF</button>
              <button id="clearBtn" class="clearbtn" disabled>CLEAR TRIP</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <aside class="right">
      <div class="panel">
        <div class="panelHead"><span>CONNECTION</span><span>USB SERIAL</span></div>
        <div class="panelBody">
          <button id="connectBtn" class="connect">CONNECT ARDUINO</button>
          <div id="message" class="message">Close Arduino Serial Monitor before connecting.</div>
        </div>
      </div>

      <div class="panel">
        <div class="panelHead"><span>CONTROLLER STATUS</span><span>LIVE</span></div>
        <div class="panelBody">
          <div class="mode"><span id="controllerText" class="modeLabel">WAITING</span><span id="badge" class="badge">OFF</span></div>
          <div class="kpis">
            <div class="kpi"><div class="kpiName">SETPOINT</div><div id="setMetric" class="kpiValue">1.000 A</div></div>
            <div class="kpi"><div class="kpiName">ERROR</div><div id="errorMetric" class="kpiValue">0.000 A</div></div>
            <div class="kpi"><div class="kpiName">SHUNT</div><div id="shuntMetric" class="kpiValue">0.00000 V</div></div>
            <div class="kpi"><div class="kpiName">CONTROL</div><div id="controlMetric" class="kpiValue">0.0000 V</div></div>
            <div class="kpi"><div class="kpiName">PWM</div><div id="pwmMetric" class="kpiValue">0 / 255</div></div>
            <div class="kpi"><div class="kpiName">STATE</div><div id="stateMetric" class="kpiValue">OFF</div></div>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panelHead"><span>QUICK SET</span><span>PRESETS</span></div>
        <div class="panelBody"><div class="presets">
          <button class="preset" data-a="1.00">1.00 A</button><button class="preset" data-a="1.50">1.50 A</button><button class="preset" data-a="2.00">2.00 A</button>
          <button class="preset" data-a="2.50">2.50 A</button><button class="preset" data-a="3.00">3.00 A</button><button class="preset" data-a="0.00">0.00 A</button>
        </div></div>
      </div>

      <div class="panel">
        <div class="panelHead"><span>3-POINT CALIBRATION</span><span>EEPROM</span></div>
        <div class="panelBody">
          <div class="calHelp">GO to the point, wait for it to settle, enter the real current from the lab supply, then CAPTURE.</div>

          <div class="calPoint">
            <div class="calHead"><span class="calTitle">1 A POINT</span><span id="calState1" class="calState">NOT SAVED</span></div>
            <div class="calRow"><button class="go" data-target="1.00">GO 1A</button><input id="calInput1" class="calInput" type="number" step="0.001" value="1.000"><button class="capture" data-point="1">CAPTURE</button></div>
            <div id="calInfo1" class="calInfo"></div>
          </div>

          <div class="calPoint">
            <div class="calHead"><span class="calTitle">2 A POINT</span><span id="calState2" class="calState">NOT SAVED</span></div>
            <div class="calRow"><button class="go" data-target="2.00">GO 2A</button><input id="calInput2" class="calInput" type="number" step="0.001" value="2.000"><button class="capture" data-point="2">CAPTURE</button></div>
            <div id="calInfo2" class="calInfo"></div>
          </div>

          <div class="calPoint">
            <div class="calHead"><span class="calTitle">3 A POINT</span><span id="calState3" class="calState">NOT SAVED</span></div>
            <div class="calRow"><button class="go" data-target="3.00">GO 3A</button><input id="calInput3" class="calInput" type="number" step="0.001" value="3.000"><button class="capture" data-point="3">CAPTURE</button></div>
            <div id="calInfo3" class="calInfo"></div>
          </div>

          <button id="resetCal" class="reset" style="margin-top:6px">RESET CALIBRATION</button>
        </div>
      </div>
    </aside>
  </main>

  <details id="debug" class="debug">
    <summary class="debugBar"><span class="debugTitle">DEBUG CONSOLE</span><span id="debugHint" class="debugHint">CLICK TO OPEN ▲</span></summary>
    <div class="debugBody">
      <div id="serialLog" class="logBox">[debug] console ready - Arduino connection is NOT required to open this panel\n</div>
      <div class="debugSide">
        <div class="cmdRow"><input id="cmdInput" class="cmdInput" placeholder="Manual command, e.g. GETCAL"><button id="cmdSend">SEND</button></div>
        <div class="miniBtns"><button data-cmd="GETCAL">GETCAL</button><button data-cmd="OFF">OFF</button><button data-cmd="CLEAR">CLEAR</button><button id="clearLog">CLEAR LOG</button></div>
        <div class="debugStats">
          <div class="debugStat">LAST RX<b id="lastRx">--</b></div>
          <div class="debugStat">PORT<b id="portInfo">--</b></div>
          <div class="debugStat">SERIAL<b id="serialState">CLOSED</b></div>
          <div class="debugStat">BAUD<b>115200</b></div>
        </div>
      </div>
    </div>
  </section>
</div>
<script>
const BAUD=115200,MAXA=3.0;
let port=null,reader=null,writer=null,run=false,buf="",setA=1,actualA=0,enabled=false,tripped=false;
const $=id=>document.getElementById(id), clamp=(v,a,b)=>Math.min(b,Math.max(a,v));

function debugLog(s,type="rx"){const l=$("serialLog");const ts=new Date().toLocaleTimeString();l.textContent+=`[${ts}] ${type.toUpperCase()}: ${s}\n`;if(l.textContent.length>30000)l.textContent=l.textContent.slice(-22000);l.scrollTop=l.scrollHeight;if(type==="rx")$("lastRx").textContent=s.slice(0,42)}
function message(t,c=""){ $("message").textContent=t; $("message").style.color=c||"#82909a"; }
function setUI(v){setA=clamp(Number(v)||0,0,MAXA);$("slider").value=setA.toFixed(2);$("number").value=setA.toFixed(2);$("setBig").textContent=setA.toFixed(2);$("setMetric").textContent=setA.toFixed(3)+" A";}
function gauge(){ $("amps").textContent=actualA.toFixed(2);$("gaugeNeedle").style.transform=`rotate(${clamp(actualA,0,3)/3*180}deg)`;$("errorMetric").textContent=(setA-actualA).toFixed(3)+" A";const a=actualA>=3;document.body.classList.toggle("alarm",a);$("alarmText").textContent=a?"HIGH CURRENT // 3.00 A":""; }
function state(){ $("badge").className="badge";if(tripped){$("controllerText").textContent="SAFETY TRIP";$("badge").textContent="TRIPPED";$("badge").classList.add("trip");$("stateMetric").textContent="TRIP";}else if(enabled){$("controllerText").textContent="CLOSED LOOP ACTIVE";$("badge").textContent="RUN";$("badge").classList.add("run");$("stateMetric").textContent="RUN";}else{$("controllerText").textContent="LOAD DISABLED";$("badge").textContent="OFF";$("stateMetric").textContent="OFF";}}
async function send(s){if(!writer){message("Not connected.","#ff4057");debugLog("send blocked: not connected","err");return}debugLog(s,"tx");await writer.write(new TextEncoder().encode(s+"\n"));}
async function connect(){if(!("serial" in navigator)){alert("Web Serial is not available in this browser engine.");return}try{port=await navigator.serial.requestPort();await port.open({baudRate:BAUD});writer=port.writable.getWriter();run=true;$("dot").classList.add("on");$("connText").textContent="SERIAL ONLINE";$("serialState").textContent="OPEN";$("connectBtn").disabled=true;["onBtn","offBtn","clearBtn"].forEach(x=>$(x).disabled=false);try{const i=port.getInfo();$("portInfo").textContent=`VID ${i.usbVendorId||"?"} / PID ${i.usbProductId||"?"}`;}catch{}message("Connected to Arduino.","#31dfa0");debugLog("serial port opened","sys");readLoop();await send("SET "+setA.toFixed(2));await send("GETCAL");}catch(e){console.error(e);message("Connection failed.","#ff4057");debugLog(String(e),"err");}}
async function readLoop(){
  const d=new TextDecoder();
  try{
    while(port&&port.readable&&run){
      reader=port.readable.getReader();
      try{
        while(run){
          const {value,done}=await reader.read();
          if(done) break;
          buf+=d.decode(value,{stream:true});
          let i;
          while((i=buf.indexOf("\n"))>=0){
            const line=buf.slice(0,i).trim();
            buf=buf.slice(i+1);
            if(line){
              debugLog(line,"rx");
              process(line);
            }
          }
        }
      } finally {
        if(reader){
          reader.releaseLock();
          reader=null;
        }
      }
    }
  } catch(e){
    console.error(e);
    message("Serial connection lost.","#ff4057");
    $("serialState").textContent="LOST";
    debugLog(String(e),"err");
  }
}
function process(line){
 if(line==="READY"){message("Arduino ready.","#31dfa0");return}
 if(line.startsWith("ACK,")){message(line.replaceAll(","," "));return}
 if(line.startsWith("CALRESULT,")){const p=line.split(","),n=Number(p[1]);if(p[2]==="OK"){const v=Number(p[3]),a=Number(p[4]);$("calState"+n).textContent="SAVED";$("calState"+n).className="calState good";$("calInfo"+n).textContent=`${v.toFixed(5)} V = ${a.toFixed(3)} A REAL`;$("calInfo"+n).className="calInfo good";message(`Calibration ${n} saved.`,"#31dfa0");}else{message(`Calibration ${n} failed.`,"#ff4057");$("calInfo"+n).textContent="CAPTURE FAILED";$("calInfo"+n).className="calInfo bad";}return}
 if(line.startsWith("CALDATA,")){const p=line.split(",");if(p.length>=10){for(let i=0;i<3;i++){const b=1+i*3,n=i+1,valid=Number(p[b])===1,v=Number(p[b+1]),a=Number(p[b+2]);if(valid){$("calState"+n).textContent="SAVED";$("calState"+n).className="calState good";$("calInfo"+n).textContent=`${v.toFixed(5)} V = ${a.toFixed(3)} A REAL`;$("calInfo"+n).className="calInfo good";}else{$("calState"+n).textContent="NOT SAVED";$("calState"+n).className="calState";$("calInfo"+n).textContent="";$("calInfo"+n).className="calInfo";}}}return}
 if(!line.startsWith("DATA,"))return;const p=line.split(",");if(p.length<8)return;const s=Number(p[1]),a=Number(p[2]),sv=Number(p[3]),cv=Number(p[4]),pwm=Number(p[5]);enabled=Number(p[6])===1;tripped=Number(p[7])===1;if(Number.isFinite(s)){setA=s;setUI(s)}if(Number.isFinite(a))actualA=a;$("shuntMetric").textContent=Number.isFinite(sv)?sv.toFixed(5)+" V":"--";$("controlMetric").textContent=Number.isFinite(cv)?cv.toFixed(4)+" V":"--";$("pwmMetric").textContent=Number.isFinite(pwm)?Math.round(pwm)+" / 255":"--";gauge();state();
}
async function setSend(v){setUI(v);await send("SET "+setA.toFixed(2));}
$("connectBtn").onclick=connect;$("slider").oninput=()=>setSend($("slider").value);$("number").onchange=()=>setSend($("number").value);$("onBtn").onclick=async()=>{await send("SET "+setA.toFixed(2));await send("ON")};$("offBtn").onclick=()=>send("OFF");$("clearBtn").onclick=()=>send("CLEAR");
document.querySelectorAll(".preset").forEach(b=>b.onclick=()=>setSend(b.dataset.a));
document.querySelectorAll(".go").forEach(b=>b.onclick=async()=>{const t=Number(b.dataset.target);setUI(t);await send("SET "+t.toFixed(2));if(!enabled)await send("ON");message(`Target ${t.toFixed(2)} A. Wait to settle, enter lab value, then CAPTURE.`,"#f2c454")});
document.querySelectorAll(".capture").forEach(b=>b.onclick=async()=>{const n=Number(b.dataset.point),v=Number($("calInput"+n).value);if(!Number.isFinite(v)||v<=0||v>5){message("Enter a valid real current from the lab supply.","#ff4057");return}message(`Capturing ${n} A point...`,"#f2c454");await send(`CAL ${n} ${v.toFixed(4)}`)});
$("resetCal").onclick=()=>{if(confirm("Delete all calibration points?"))send("CALRESET")};
$("debug").addEventListener("toggle",()=>{$("debugHint").textContent=$("debug").open?"CLICK TO CLOSE ▼":"CLICK TO OPEN ▲";debugLog($("debug").open?"debug console opened":"debug console closed","sys")});
$("cmdSend").onclick=()=>{const v=$("cmdInput").value.trim();if(v){send(v);$("cmdInput").value=""}};$("cmdInput").addEventListener("keydown",e=>{if(e.key==="Enter")$("cmdSend").click()});document.querySelectorAll(".miniBtns [data-cmd]").forEach(b=>b.onclick=()=>send(b.dataset.cmd));$("clearLog").onclick=()=>{$("serialLog").textContent="[debug] log cleared\n"};
setUI(1);gauge();state();
</script>
</body>
</html>
